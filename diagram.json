{
  "version": 1,
  "author": "BCA182 Student",
  "editor": "wokwi",
  "serialMonitor": {
    "display": "always"
  },
  "parts": [
    {
      "type": "board-stm32-bluepill",
      "id": "mcu",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht22",
      "top": -180,
      "left": -20,
      "attrs": {
        "temperature": "25",
        "humidity": "50"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "dht22_pullup",
      "top": -180,
      "left": -150,
      "attrs": {
        "value": "4700"
      }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr",
      "top": -180,
      "left": 150,
      "attrs": {
        "lux": "500"
      }
    },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir",
      "top": -180,
      "left": 310,
      "attrs": {
        "delayTime": "5",
        "inhibitTime": "1.2"
      }
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": 30,
      "left": 250,
      "attrs": {
        "i2cAddress": "0x3c"
      }
    },
    {
      "type": "wokwi-ky-040",
      "id": "encoder",
      "top": 360,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 360,
      "left": 200,
      "attrs": {
        "mode": "smooth",
        "volume": "0.8"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "led_r",
      "top": 430,
      "left": 380,
      "attrs": {
        "value": "330"
      }
    },
    {
      "type": "wokwi-led",
      "id": "led",
      "top": 430,
      "left": 500,
      "attrs": {
        "color": "red"
      }
    }
  ],
