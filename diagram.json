{
  "version": 1,
  "author": "BCA182 Student",
  "editor": "wokwi",
  "serialMonitor": {
    "display": "always"
  },
  "parts": [
    {
      "type": "board-stm32-bluepill",
      "id": "mcu",
      "top": 0,
      "left": 0
    },
    {
      "type": "wokwi-dht22",
      "id": "dht22",
      "top": -120,
      "left": 50,
      "attrs": {
        "temperature": "25",
        "humidity": "50"
      }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr",
      "top": -120,
      "left": 200,
      "attrs": {}
    },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir",
      "top": -120,
      "left": 350,
      "attrs": {
        "delayTime": "5",
        "inhibitTime": "1.2"
      }
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": 100,
      "left": 50,
      "attrs": {
        "i2cAddress": "0x3c"
      }
    },
    {
      "type": "wokwi-ky-040",
      "id": "encoder",
      "top": 100,
      "left": 280
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 100,
      "left": 480,
      "attrs": {
        "mode": "smooth",
        "volume": "0.8"
      }
    }
  ],
  "connections": [
    ["mcu:PA1", "dht22:SDA", "green", ["h0"]],
    ["mcu:3.3V", "dht22:VCC", "red", ["h0"]],
    ["mcu:GND.1", "dht22:GND", "black", ["h0"]],
    ["mcu:PA0", "ldr:AO", "orange", ["h0"]],
    ["mcu:3.3V", "ldr:VCC", "red", ["h0"]],
    ["mcu:GND.1", "ldr:GND", "black", ["h0"]],
    ["mcu:PB0", "pir:OUT", "red", ["h0"]],
    ["mcu:5V", "pir:VCC", "red", ["h0"]],
    ["mcu:GND.1", "pir:GND", "black", ["h0"]],
    ["mcu:PB6", "oled:SCL", "blue", ["h0"]],
    ["mcu:PB7", "oled:SDA", "purple", ["h0"]],
    ["mcu:3.3V", "oled:VCC", "red", ["h0"]],
    ["mcu:GND.1", "oled:GND", "black", ["h0"]],
    ["mcu:PA2", "encoder:CLK", "cyan", ["h0"]],
    ["mcu:PA3", "encoder:DT", "magenta", ["h0"]],
    ["mcu:PA4", "encoder:SW", "yellow", ["h0"]],
    ["mcu:3.3V", "encoder:VCC", "red", ["h0"]],
    ["mcu:GND.1", "encoder:GND", "black", ["h0"]],
    ["mcu:PB8", "buzzer:2", "red", ["h0"]],
    ["mcu:GND.1", "buzzer:1", "black", ["h0"]]
  ]
}
